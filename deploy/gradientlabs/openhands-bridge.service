[Unit]
Description=Stable loopback OpenHands ingress
After=docker.service
Wants=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/openhands/bridge.py
WorkingDirectory=/opt/openhands
Restart=always
RestartSec=2
LimitNOFILE=8192
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
